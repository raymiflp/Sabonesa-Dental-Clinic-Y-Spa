# Betty Dental - Backend Environment Variables
# Copy this file to .env and adjust as needed

# SQLite Database (local)
DATABASE_URL="file:./dev.db"

# JWT Secret for authentication
JWT_SECRET="betty-dev-secret"

# CORS: allow all origins in local network
CORS_ORIGIN=*

# Disable rate limiting for local use
SKIP_RATE_LIMIT=true

# Cloudinary (imágenes/fotos de pacientes) - Opcional
# Obtén estos datos en https://cloudinary.com/console
# CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_cloud_name
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=abc123def456
